{
  "name": "dictadapt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Outil d'aide a la dictee pour les eleves en difficulte - environnement gratuit DysAdapt",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync android",
    "cap:android": "npm run cap:sync && cap open android"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^6.1.0",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.562.0",
    "nanoid": "^5.1.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "@eslint/js": "^9.39.0",
    "@tailwindcss/postcss": "^4.1.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.2",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.14",
    "vite-plugin-pwa": "^1.0.4",
    "vitest": "^3.2.4"
  }
}
